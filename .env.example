# Copy to .env and change every value before going live
API_KEY=change-me-api-key
JWT_SECRET_KEY=change-me-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
REDIS_URL=redis://localhost:6379

# Optional business details printed on the PDF quotation (leave empty to omit)
QUOTE_BUSINESS_NAME=Revora
QUOTE_BUSINESS_ADDRESS=
QUOTE_BUSINESS_PHONE=
QUOTE_BUSINESS_EMAIL=
QUOTE_BUSINESS_GSTIN=
QUOTE_VALID_DAYS=7

# Security
JWT_EXPIRE_MINUTES=30            # users must log in again after this (and after refreshing the page)
LOGIN_MAX_FAILURES=5             # failed logins before a temporary lock-out
LOGIN_LOCK_MINUTES=15
RESET_CODE_MINUTES=30            # password-reset codes expire after this
EMAILS_PER_USER_PER_DAY=20       # quotation emails a user may send per day

# Outgoing email (password reset, emailing quotations). Leave SMTP_HOST empty to switch these features off.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
# SMTP_PASSWORD=<Gmail app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Database backups (backup service): every BACKUP_INTERVAL_HOURS, keeping the newest BACKUP_KEEP copies
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Public website address for the optional HTTPS service (docker compose --profile https up -d)
DOMAIN=
